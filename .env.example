# ── RapidAPI ────────────────────────────────────────────────────────────────
# One account key works for all three APIs below.
# Subscribe to each individually (free tiers available) at rapidapi.com:
#
#   JSearch (Indeed + LinkedIn aggregate):
#     rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
#
#   Active Jobs DB (pre-validated ATS URLs):
#     rapidapi.com/fantastic-jobs-fantastic-jobs-default/api/active-jobs-db
#
#   LinkedIn Jobs Search (direct LinkedIn feed):
#     rapidapi.com/bebity/api/linkedin-jobs-search
#
RAPIDAPI_KEY=your_key_here

# ── Scraper toggles (set to false to disable) ────────────────────────────────
ENABLE_JSEARCH=true
ENABLE_ACTIVEJOBSDB=true
ENABLE_LINKEDIN=true

# ── Search defaults ───────────────────────────────────────────────────────────
DEFAULT_KEYWORDS=java developer
DEFAULT_LOCATION=remote
DEFAULT_COUNTRY=us
DEFAULT_SALARY_MIN=100000

# JSearch recency filter — options: today, 3days, week, month
JSEARCH_DATE_POSTED=3days
